NEXT_PUBLIC_SUPABASE_URL=https://tgudhcgpllbqfxmpvnst.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production E2E only. Keep in GitHub Actions secrets, never expose to the browser.
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

DATABASE_URL=
DIRECT_URL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

TMDB_API_KEY=

# ЮKassa (поддерживаются оба префикса: YOO_KASSA_* и YOOKASSA_*)
YOO_KASSA_SHOP_ID=
YOO_KASSA_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional public build label included in privacy-safe telemetry records.
NEXT_PUBLIC_APP_RELEASE=

# Server-only Google Web Risk Lookup key. Checked URLs are disclosed to Google,
# but must never be written to Voople logs or telemetry.
GOOGLE_WEB_RISK_API_KEY=

# Emergency server-side kill switch. Set to false to keep desktop screen video
# while refusing new native process-audio publisher leases.
DESKTOP_NATIVE_PROCESS_AUDIO_ENABLED=true

# Public HTTPS URL of the current Windows installer. The landing page exposes
# only the stable same-origin /download/desktop endpoint.
DESKTOP_INSTALLER_URL=

# LiveKit: URL доступен клиенту, ключ и secret — только серверу
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_URL=
# Необязательные резервные/региональные WSS endpoints через запятую.
# Для РФ рекомендуется отдельный домен LiveKit с TURN/TLS на TCP 443.
LIVEKIT_FALLBACK_URLS=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Selectel S3 (посты/аватар — public; чат — private)
S3_ENDPOINT=https://s3.ru-3.storage.selcloud.ru
S3_REGION=ru-3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=voople-assets
S3_BUCKET_PRIVATE=voople-uploads

# CDN ассетов (бейдж Voople+, customization): https://cdn.voople.ru
NEXT_PUBLIC_ASSETS_CDN_URL=

# UniSender Go Web API. Server-only; auth.voople.ru must be verified in UniSender.
UNISENDER_GO_API_KEY=
UNISENDER_GO_FROM_EMAIL=auth@voople.ru
UNISENDER_GO_FROM_NAME=Voople
# Optional provider override. Keep empty in production unless UniSender changes the endpoint.
UNISENDER_GO_API_URL=

# Generate three independent random values of at least 32 characters. Never use NEXT_PUBLIC_*.
ACCOUNT_DELETION_VERIFICATION_SECRET=
ACCOUNT_DELETION_AUDIT_SECRET=
ACCOUNT_DELETION_WORKER_SECRET=

LIVEKIT_FALLBACK_URLS=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
