# Deployment applies migrations separately; neither directory belongs in the public repository.
/docs/
/drizzle/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-start.*.log
/.pnpm-store/
/.claude/settings.local.json

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
