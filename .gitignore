!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright/.auth/
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# Local project notes and ad-hoc SQL stay on developer machines. The shared
# component map and release-required migrations are explicit repository contracts.
/docs/*
!/docs/component-platform-map.md
!/docs/redesign-implementation-matrix.md
/drizzle/*
!/drizzle/38-group-emojis.sql
!/drizzle/39-structured-chat-content.sql
!/drizzle/43-group-sounds.sql
!/drizzle/45-app-schema-migrations.sql
!/drizzle/46-legacy-emoji-backfill.sql
!/drizzle/47-message-reactions-replica-identity.sql
# Local toolchain experiment for the feature-gated Windows process-audio build.
/desktop/src-tauri/.cargo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-start.*.log
/.pnpm-store/
/.claude/settings.local.json

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
