# Public client values. Never put service-role keys in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Optional override. Dev defaults to the local Next API; release defaults to https://voople.ru.
VITE_VOOPLE_API_URL=https://voople.ru
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key

# During local development, the desktop package also reads the matching
# NEXT_PUBLIC_* values from the repository root automatically.
