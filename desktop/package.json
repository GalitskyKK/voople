{
  "name": "@voople/desktop",
  "version": "0.1.30",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,desktop \"npm run dev:api\" \"npm run dev:renderer\"",
    "dev:api": "npm --prefix .. run dev -- --hostname 127.0.0.1",
    "dev:renderer": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-debug.ps1",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev.ps1",
    "tauri:build": "tauri build",
    "tauri:build:process-audio": "tauri build --features process-audio-publisher"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-query": "^5.100.11",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "livekit-client": "^2.21.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "superjson": "^2.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
